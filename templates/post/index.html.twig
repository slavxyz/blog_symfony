{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
<h1>Blog Posts</h1>

<ul>
    {% for post in posts %}
        <li>
            <a href="{{ path('app_post_show', {id: post.id}) }}">
                {{ post.title }}
            </a>
        </li>
    {% endfor %}
</ul>

<a href="{{ path('app_post_new') }}" class="btn btn-primary">New Post</a>
{% endblock %}
